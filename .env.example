# Copy to .env and fill in. Never commit real values.

# PostgreSQL (Supabase pooler URL works)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# LINE Messaging API + LIFF
LINE_CHANNEL_ACCESS_TOKEN=""
LINE_CHANNEL_SECRET=""
NEXT_PUBLIC_LIFF_ID=""
# LINE Login channel that owns the LIFF app, used for "Sign in with LINE" on the web.
# Channel ID defaults to the part of NEXT_PUBLIC_LIFF_ID before "-". The secret is the LINE Login
# channel's secret (not the Messaging API one). Register https://<domain>/api/auth/line/callback
# as a Callback URL in that channel, and link the LINE OA to it for the add-friend prompt.
# LINE_LOGIN_CHANNEL_ID=""
LINE_LOGIN_CHANNEL_SECRET=""

# Optional: key for signing session cookies (defaults to a key derived from LINE_CHANNEL_SECRET).
# Changing it signs everyone out.
# SESSION_SECRET=""

# Google AI Studio (Gemini). Optional AI_MODELS overrides the model fallback order.
AI_API_KEY=""
# AI_MODELS="gemini-3.8-flash,gemini-3.5-flash,gemini-3.5-flash-lite"

# Shared secret Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>" (generate: openssl rand -hex 32)
CRON_SECRET=""

# Password for the /admin back office
ADMIN_PASSWORD=""

# EasySlip (https://easyslip.com): verifies Pro payment slips with the bank. Link the PromptPay
# account that receives payments to the EasySlip branch. Without this key, Pro upgrades are refused.
EASYSLIP_API_KEY=""

# Public URL of the site, used for canonical links, sitemap, structured data and LINE links
NEXT_PUBLIC_SITE_URL="https://www.paopao-wallet.com"
