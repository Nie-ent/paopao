# Copy to .env and fill in. Never commit real values.

# PostgreSQL (Supabase pooler URL works)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Supabase (auth)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# LINE Messaging API + LIFF
LINE_CHANNEL_ACCESS_TOKEN=""
LINE_CHANNEL_SECRET=""
NEXT_PUBLIC_LIFF_ID=""
# Optional: LINE Login channel that owns the LIFF app (defaults to the part of NEXT_PUBLIC_LIFF_ID before "-")
# LINE_LOGIN_CHANNEL_ID=""

# Optional: key for signing session cookies (defaults to a key derived from LINE_CHANNEL_SECRET).
# Changing it signs everyone out.
# SESSION_SECRET=""

# Google AI Studio (Gemini). Optional AI_MODELS overrides the model fallback order.
AI_API_KEY=""
# AI_MODELS="gemini-3.8-flash,gemini-flash-latest,gemini-3.5-flash"

# Shared secret Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>" (generate: openssl rand -hex 32)
CRON_SECRET=""

# Password for the /admin back office
ADMIN_PASSWORD=""
