generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SubscriptionTier {
  FREE
  PRO
  BUSINESS
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum GoalType {
  FINANCIAL
  TODO
}

enum RewardStatus {
  AVAILABLE
  OUT_OF_STOCK
  HIDDEN
}

enum ClaimStatus {
  PENDING
  SHIPPED
  REJECTED
}

enum QuestType {
  ONETIME
  DAILY
}

enum QuestCondition {
  NONE
  LOG_TRANSACTION_TODAY
}

enum QuestStatus {
  ACTIVE
  INACTIVE
}

model User {
  id               String           @id @default(uuid())
  lineId           String           @unique
  name             String?
  avatarUrl        String?
  salaryDeduction  Float            @default(875)
  freelanceTaxRate Float            @default(3.0)
  otp              String?
  otpExpiresAt     DateTime?
  hasAcceptedPDPA  Boolean          @default(false)
  subscriptionTier SubscriptionTier @default(FREE)
  aiSlipsUsed      Int              @default(0)
  aiQuotaResetDate DateTime?
  paoPoints        Int              @default(0)
  lastDailyQuestAt DateTime?
  
  transactions     Transaction[]
  categories       Category[]
  goals            Goal[]
  chatSessions     ChatSession[]
  rewardClaims     RewardClaim[]
  questClaims      QuestClaim[]

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @default(now()) @updatedAt
}

model Category {
  id        String          @id @default(uuid())
  userId    String?
  user      User?           @relation(fields: [userId], references: [id])
  name      String
  type      TransactionType
  color     String          @default("#64748b")
  icon      String?
  
  transactions Transaction[]
  
  createdAt DateTime        @default(now())
  updatedAt DateTime        @default(now()) @updatedAt

  @@index([userId])
}

model Transaction {
  id        String          @id @default(uuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id])
  type      TransactionType
  amount    Float
  categoryId String
  category  Category        @relation(fields: [categoryId], references: [id])
  note      String?
  date      DateTime        @default(now())
  
  createdAt DateTime        @default(now())
  updatedAt DateTime        @default(now()) @updatedAt

  @@index([userId, date])
  @@index([userId, type])
}

model Goal {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  type          GoalType  @default(FINANCIAL)
  targetAmount  Float     @default(0)
  currentAmount Float     @default(0)
  trackCategory String?
  title         String
  description   String?
  deadline      DateTime?
  isCompleted   Boolean   @default(false)
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  @@index([userId])
}

model ChatSession {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String   @default("New Conversation")
  messages  Json
  
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([userId])
}

model Reward {
  id          String         @id @default(uuid())
  name        String
  description String?
  points      Int
  iconString  String         @default("🎁")
  status      RewardStatus   @default(AVAILABLE)
  
  claims      RewardClaim[]
  
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @default(now()) @updatedAt
}

model RewardClaim {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  rewardId  String
  reward    Reward      @relation(fields: [rewardId], references: [id])
  status    ClaimStatus @default(PENDING)
  
  createdAt DateTime    @default(now())
  updatedAt DateTime    @default(now()) @updatedAt

  @@index([userId])
}

model Quest {
  id          String         @id @default(uuid())
  title       String
  description String?
  points      Int
  type        QuestType      @default(ONETIME)
  condition   QuestCondition @default(NONE)
  status      QuestStatus    @default(ACTIVE)
  
  claims      QuestClaim[]
  
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @default(now()) @updatedAt
}

model QuestClaim {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  questId   String
  quest     Quest    @relation(fields: [questId], references: [id])
  
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([userId])
}
