generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SubscriptionTier {
  FREE
  PRO
  BUSINESS
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum GoalType {
  FINANCIAL
  TODO
}

enum RewardStatus {
  AVAILABLE
  OUT_OF_STOCK
  HIDDEN
}

enum ClaimStatus {
  PENDING
  SHIPPED
  REJECTED
}

enum QuestType {
  ONETIME
  DAILY
}

enum QuestCondition {
  NONE
  LOG_TRANSACTION_TODAY
}

enum QuestStatus {
  ACTIVE
  INACTIVE
}

model User {
  id               String           @id @default(uuid())
  lineId           String           @unique
  name             String?
  avatarUrl        String?
  hasAcceptedPDPA  Boolean          @default(false)
  subscriptionTier SubscriptionTier @default(FREE)
  /// End of the paid Pro period. Pro only counts while this is in the future (src/lib/subscription.ts)
  proExpiresAt     DateTime?
  /// When the one-time free Pro trial was started (null = never)
  trialStartedAt   DateTime?
  /// Slip images read by AI this month (Pro fair-use cap); reset on aiQuotaResetDate
  aiSlipsUsed      Int              @default(0)
  aiQuotaResetDate DateTime?
  paoPoints        Int              @default(0)
  lastDailyQuestAt DateTime?
  
  transactions     Transaction[]
  categories       Category[]
  goals            Goal[]
  chatSessions     ChatSession[]
  rewardClaims     RewardClaim[]
  questClaims      QuestClaim[]
  subscriptionPayments SubscriptionPayment[]
  usageEvents      UsageEvent[]
  recurringBills   RecurringBill[]
  pendingEntry     PendingEntry?
  /// Code in the user's invite link (/r/<code>), created the first time they open "invite friends"
  referralCode     String?          @unique
  referralsMade    Referral[]       @relation("referrer")
  referredBy       Referral?        @relation("referee")

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @default(now()) @updatedAt
}

model Category {
  id        String          @id @default(uuid())
  userId    String?
  user      User?           @relation(fields: [userId], references: [id])
  name      String
  type      TransactionType
  color     String          @default("#64748b")
  icon      String?
  
  transactions Transaction[]
  
  createdAt DateTime        @default(now())
  updatedAt DateTime        @default(now()) @updatedAt

  @@index([userId])
}

model Transaction {
  id        String          @id @default(uuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id])
  type      TransactionType
  amount    Float
  categoryId String
  category  Category        @relation(fields: [categoryId], references: [id])
  note      String?
  date      DateTime        @default(now())
  /// Bank reference printed on a slip or statement row, used to detect duplicates
  reference String?
  /// SHA-256 of the slip image the transaction was read from
  slipHash  String?
  
  createdAt DateTime        @default(now())
  updatedAt DateTime        @default(now()) @updatedAt

  @@unique([userId, reference])
  @@unique([userId, slipHash])
  @@index([userId, date])
  @@index([userId, type])
}

/// A PRO upgrade paid by transfer slip. The reference is unique across all users so a slip
/// can't be reused (by its owner or anyone else) to upgrade again.
model SubscriptionPayment {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  reference String   @unique
  slipHash  String?  @unique
  amount    Float
  /// MONTHLY or YEARLY (src/lib/subscription.ts PRO_PLANS)
  plan      String   @default("MONTHLY")
  createdAt DateTime @default(now())

  @@index([userId])
}

model Goal {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  type          GoalType  @default(FINANCIAL)
  targetAmount  Float     @default(0)
  currentAmount Float     @default(0)
  trackCategory String?
  title         String
  description   String?
  deadline      DateTime?
  isCompleted   Boolean   @default(false)
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  @@index([userId])
}

model ChatSession {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String   @default("New Conversation")
  messages  Json
  
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([userId])
}

model Reward {
  id          String         @id @default(uuid())
  /// Thai (default) name and description; the *En fields are shown in the English UI
  name        String
  description String?
  nameEn        String?
  descriptionEn String?
  points      Int
  iconString  String         @default("🎁")
  status      RewardStatus   @default(AVAILABLE)
  
  claims      RewardClaim[]
  
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @default(now()) @updatedAt
}

model RewardClaim {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  rewardId  String
  reward    Reward      @relation(fields: [rewardId], references: [id])
  status    ClaimStatus @default(PENDING)
  
  createdAt DateTime    @default(now())
  updatedAt DateTime    @default(now()) @updatedAt

  @@index([userId])
}

model Quest {
  id          String         @id @default(uuid())
  /// Thai (default) title and description; the *En fields are shown in the English UI
  title       String
  description String?
  titleEn       String?
  descriptionEn String?
  points      Int
  type        QuestType      @default(ONETIME)
  condition   QuestCondition @default(NONE)
  status      QuestStatus    @default(ACTIVE)
  
  claims      QuestClaim[]
  
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @default(now()) @updatedAt
}

model QuestClaim {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  questId   String
  quest     Quest    @relation(fields: [questId], references: [id])
  
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([userId])
}

/// One admin password attempt, used to rate-limit guessing per IP
model LoginAttempt {
  id        String   @id @default(uuid())
  ip        String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
  @@index([createdAt])
}

/// One use of a metered feature (e.g. a statement import or a slip verification), for daily limits
model UsageEvent {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  createdAt DateTime @default(now())

  @@index([userId, kind, createdAt])
}

enum BillFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

/// A recurring bill or expense (rent, electricity…) that PaoPao asks about on LINE when it is due (Pro)
model RecurringBill {
  id          String        @id @default(uuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  /// Category name used when the bill is recorded
  category    String
  /// The usual amount, offered as a one-tap answer; updated to the last amount recorded
  amount      Float?
  frequency   BillFrequency
  /// WEEKLY: 0 = Sunday … 6 = Saturday (Bangkok)
  dayOfWeek   Int?
  /// MONTHLY: 1–31; months without that day use their last day
  dayOfMonth  Int?
  active      Boolean       @default(true)
  /// Bangkok day (YYYY-MM-DD) the bill was last asked about, so a re-run cron doesn't ask twice
  lastAskedOn String?

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now()) @updatedAt

  @@index([userId])
}

/// Entries read from a LINE message, waiting for the user to tap "confirm" (one open draft per user)
model PendingEntry {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// [{ type, amount, category, note, reference?, slipHash? }]
  items     Json
  /// Notices shown with the draft (duplicate slips, receiver mismatch)
  notices   Json     @default("[]")
  /// Index of the item whose amount the next typed number replaces, or null
  awaitingAmount Int?
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

enum ReferralStatus {
  PENDING
  QUALIFIED
  EXPIRED
}

/// A friend who signed up through someone's invite link. Rules: src/lib/referral.ts
model Referral {
  id          String         @id @default(uuid())
  referrerId  String
  referrer    User           @relation("referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  refereeId   String         @unique
  referee     User           @relation("referee", fields: [refereeId], references: [id], onDelete: Cascade)
  status      ReferralStatus @default(PENDING)
  /// When the friend qualified (logged entries on enough different days in time)
  qualifiedAt DateTime?
  /// When the referrer got their free Pro month; stays null if they had already reached the limit
  rewardedAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @default(now()) @updatedAt

  @@index([referrerId])
  @@index([status, createdAt])
}
