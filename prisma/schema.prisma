generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SubscriptionTier {
  FREE
  PRO
  BUSINESS
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum GoalType {
  FINANCIAL
  TODO
}

enum RewardStatus {
  AVAILABLE
  OUT_OF_STOCK
  HIDDEN
}

enum ClaimStatus {
  PENDING
  SHIPPED
  REJECTED
}

enum QuestType {
  ONETIME
  DAILY
}

enum QuestCondition {
  NONE
  LOG_TRANSACTION_TODAY
}

enum QuestStatus {
  ACTIVE
  INACTIVE
}

model User {
  id               String           @id @default(uuid())
  lineId           String           @unique
  name             String?
  avatarUrl        String?
  hasAcceptedPDPA  Boolean          @default(false)
  subscriptionTier SubscriptionTier @default(FREE)
  /// End of the paid Pro period. Pro only counts while this is in the future (src/lib/subscription.ts)
  proExpiresAt     DateTime?
  /// When the one-time free Pro trial was started (null = never)
  trialStartedAt   DateTime?
  /// Slip images read by AI this month (Pro fair-use cap); reset on aiQuotaResetDate
  aiSlipsUsed      Int              @default(0)
  aiQuotaResetDate DateTime?
  paoPoints        Int              @default(0)
  lastDailyQuestAt DateTime?
  
  transactions     Transaction[]
  categories       Category[]
  goals            Goal[]
  chatSessions     ChatSession[]
  rewardClaims     RewardClaim[]
  questClaims      QuestClaim[]
  subscriptionPayments SubscriptionPayment[]
  usageEvents      UsageEvent[]
  aiUsages         AiUsage[]
  recurringBills   RecurringBill[]
  pendingEntry     PendingEntry?
  /// LINE summary for Pro: weekly (Mondays) by default to save LINE pushes, daily or off by choice
  briefFrequency   BriefFrequency   @default(WEEKLY)
  /// When the "your trial ends soon" LINE message was sent (once per account)
  trialReminderSentAt DateTime?
  /// Newest "what's new" release the user dismissed (src/features/releases/notes.ts)
  lastSeenRelease  String?
  /// Code in the user's invite link (/r/<code>), created the first time they open "invite friends"
  referralCode     String?          @unique
  referralsMade    Referral[]       @relation("referrer")
  referredBy       Referral?        @relation("referee")

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @default(now()) @updatedAt
}

model Category {
  id        String          @id @default(uuid())
  userId    String?
  user      User?           @relation(fields: [userId], references: [id])
  name      String
  type      TransactionType
  color     String          @default("#64748b")
  icon      String?
  
  transactions Transaction[]
  
  createdAt DateTime        @default(now())
  updatedAt DateTime        @default(now()) @updatedAt

  @@index([userId])
}

model Transaction {
  id        String          @id @default(uuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id])
  type      TransactionType
  /// Baht, exact to the satang (read as a number: src/lib/money.ts)
  amount    Decimal         @db.Decimal(12, 2)
  categoryId String
  category  Category        @relation(fields: [categoryId], references: [id])
  note      String?
  date      DateTime        @default(now())
  /// Bank reference printed on a slip or statement row, used to detect duplicates
  reference String?
  /// SHA-256 of the slip image the transaction was read from
  slipHash  String?
  
  createdAt DateTime        @default(now())
  updatedAt DateTime        @default(now()) @updatedAt

  @@unique([userId, reference])
  @@unique([userId, slipHash])
  @@index([userId, date])
  @@index([userId, type])
}

/// A PRO upgrade paid by transfer slip. The reference is unique across all users so a slip
/// can't be reused (by its owner or anyone else) to upgrade again.
model SubscriptionPayment {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  reference String   @unique
  slipHash  String?  @unique
  amount    Decimal  @db.Decimal(12, 2)
  /// MONTHLY or YEARLY (src/lib/subscription.ts PRO_PLANS)
  plan      String   @default("MONTHLY")
  createdAt DateTime @default(now())

  @@index([userId])
}

model Goal {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  type          GoalType  @default(FINANCIAL)
  targetAmount  Decimal   @default(0) @db.Decimal(12, 2)
  currentAmount Decimal   @default(0) @db.Decimal(12, 2)
  trackCategory String?
  title         String
  description   String?
  deadline      DateTime?
  isCompleted   Boolean   @default(false)
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  @@index([userId])
}

model ChatSession {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String   @default("New Conversation")
  messages  Json
  
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([userId])
}

model Reward {
  id          String         @id @default(uuid())
  /// Thai (default) name and description; the *En fields are shown in the English UI
  name        String
  description String?
  nameEn        String?
  descriptionEn String?
  points      Int
  iconString  String         @default("🎁")
  status      RewardStatus   @default(AVAILABLE)
  
  claims      RewardClaim[]
  
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @default(now()) @updatedAt
}

model RewardClaim {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  rewardId  String
  reward    Reward      @relation(fields: [rewardId], references: [id])
  status    ClaimStatus @default(PENDING)
  
  createdAt DateTime    @default(now())
  updatedAt DateTime    @default(now()) @updatedAt

  @@index([userId])
}

model Quest {
  id          String         @id @default(uuid())
  /// Thai (default) title and description; the *En fields are shown in the English UI
  title       String
  description String?
  titleEn       String?
  descriptionEn String?
  points      Int
  type        QuestType      @default(ONETIME)
  condition   QuestCondition @default(NONE)
  status      QuestStatus    @default(ACTIVE)
  
  claims      QuestClaim[]
  
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @default(now()) @updatedAt
}

model QuestClaim {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  questId   String
  quest     Quest    @relation(fields: [questId], references: [id])
  
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([userId])
}

/// One admin password attempt, used to rate-limit guessing per IP
model LoginAttempt {
  id        String   @id @default(uuid())
  ip        String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
  @@index([createdAt])
}

/// One use of a metered feature (e.g. a statement import or a slip verification), for daily limits
/// Tokens of one successful Gemini call (src/lib/ai-usage.ts); cost is priced when read
model AiUsage {
  id           String   @id @default(uuid())
  /// Null when the call had no user (or the account was deleted: usage history is kept)
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// What the call was for: entry_text, slip, statement, chat, chat_title, insight, advice
  feature      String
  model        String
  inputTokens  Int
  /// Includes thinking tokens, which Gemini bills as output
  outputTokens Int
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
}

model UsageEvent {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  createdAt DateTime @default(now())

  @@index([userId, kind, createdAt])
}

enum BillFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

/// A recurring bill or expense (rent, electricity…) that PaoPao asks about on LINE when it is due (Pro)
model RecurringBill {
  id          String        @id @default(uuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  /// Category name used when the bill is recorded
  category    String
  /// The usual amount, offered as a one-tap answer; updated to the last amount recorded
  amount      Decimal?      @db.Decimal(12, 2)
  frequency   BillFrequency
  /// WEEKLY: 0 = Sunday … 6 = Saturday (Bangkok)
  dayOfWeek   Int?
  /// MONTHLY: 1–31; months without that day use their last day
  dayOfMonth  Int?
  active      Boolean       @default(true)
  /// Essential (rent, power) or could be cut (subscriptions): splits fixed costs (src/lib/fixed-costs.ts)
  essential   Boolean       @default(true)
  /// Bangkok day (YYYY-MM-DD) the bill was last asked about, so a re-run cron doesn't ask twice
  lastAskedOn String?

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now()) @updatedAt

  @@index([userId])
}

/// Entries read from a LINE message, waiting for the user to tap "confirm" (one open draft per user)
model PendingEntry {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// [{ type, amount, category, note, reference?, slipHash? }]
  items     Json
  /// Notices shown with the draft (duplicate slips, receiver mismatch)
  notices   Json     @default("[]")
  /// Index of the item whose amount the next typed number replaces, or null
  awaitingAmount Int?
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

enum BriefFrequency {
  WEEKLY
  DAILY
  OFF
}

enum ReferralStatus {
  PENDING
  QUALIFIED
  EXPIRED
}

/// A friend who signed up through someone's invite link. Rules: src/lib/referral.ts
model Referral {
  id          String         @id @default(uuid())
  referrerId  String
  referrer    User           @relation("referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  refereeId   String         @unique
  referee     User           @relation("referee", fields: [refereeId], references: [id], onDelete: Cascade)
  status      ReferralStatus @default(PENDING)
  /// When the friend qualified (logged entries on enough different days in time)
  qualifiedAt DateTime?
  /// When the referrer got their free Pro month; stays null if they had already reached the limit
  rewardedAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @default(now()) @updatedAt

  @@index([referrerId])
  @@index([status, createdAt])
}

// ── LINE groups: split bills and track who owes whom (src/services/group.service.ts) ──

enum GroupBillStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum GroupDebtStatus {
  OPEN
  /// The debtor said they paid (cash or no slip); waiting for the creditor to confirm
  CLAIMED
  PAID
  CANCELLED
}

/// A LINE group or multi-person chat PaoPao was invited to
model LineGroup {
  id          String    @id @default(uuid())
  /// LINE groupId or roomId
  lineGroupId String    @unique
  /// GROUP or ROOM (decides which LINE profile API to call)
  kind        String
  name        String?
  /// Who armed receipt reading with "แยกบิล" and until when (the next image anyone sends is read as a receipt)
  armedBy     String?
  armedUntil  DateTime?
  leftAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  members     GroupMember[]
  bills       GroupBill[]
  debts       GroupDebt[]
  usage       GroupUsageEvent[]
}

/// A LINE user's name as shown in a group, cached from the LINE API
model GroupMember {
  id          String    @id @default(uuid())
  groupId     String
  group       LineGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  lineUserId  String
  displayName String
  pictureUrl  String?
  updatedAt   DateTime  @default(now()) @updatedAt

  @@unique([groupId, lineUserId])
}

/// Settings a LINE user keeps across groups (they need not be a PaoPao user)
model LinePayee {
  lineUserId  String   @id
  /// PromptPay phone or ID for the QR shown to people who owe them (encrypted: src/lib/field-crypto.ts)
  promptPayId String?
  /// Text of the user's own payment QR (e.g. a bank's "My QR"), read from their photo in the browser;
  /// used when there is no PromptPay number (encrypted). Only one of the two is set.
  qrPayload   String?
  updatedAt   DateTime @default(now()) @updatedAt
}

model GroupBill {
  id             String          @id @default(uuid())
  groupId        String
  group          LineGroup       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  /// LINE user who sent the receipt; they can edit the bill
  createdBy      String
  /// LINE user who paid the shop, and is owed by everyone else
  paidBy         String
  title          String
  /// Baht added on top of the items, shared in proportion to each person's items
  serviceCharge  Decimal         @default(0) @db.Decimal(12, 2)
  vat            Decimal         @default(0) @db.Decimal(12, 2)
  /// Baht taken off the whole bill, shared the same way
  discount       Decimal         @default(0) @db.Decimal(12, 2)
  /// Grand total printed on the receipt. When set, shares always add up to it: whatever the items
  /// don't cover (service, VAT, VAT on service, rounding) is shared in proportion (src/lib/group-split.ts)
  printedTotal   Decimal?        @db.Decimal(12, 2)
  status         GroupBillStatus @default(OPEN)
  /// SHA-256 of the receipt image, to warn about the same receipt twice
  receiptHash    String?
  closedAt       DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @default(now()) @updatedAt

  items          GroupBillItem[]
  debts          GroupDebt[]

  @@index([groupId, createdAt])
}

model GroupBillItem {
  id        String           @id @default(uuid())
  billId    String
  bill      GroupBill        @relation(fields: [billId], references: [id], onDelete: Cascade)
  name      String
  /// Line total in baht (all units), before this item's own discount
  amount    Decimal          @db.Decimal(12, 2)
  /// Discount printed against this item only; only the people who had it get it
  discount  Decimal          @default(0) @db.Decimal(12, 2)
  quantity  Int              @default(1)
  position  Int
  claims    GroupBillClaim[]

  @@index([billId])
}

/// A person who had (part of) an item, and how many of its units
model GroupBillClaim {
  id         String        @id @default(uuid())
  itemId     String
  item       GroupBillItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  lineUserId String
  /// Units of the item this person had (e.g. 7 of 19 plates); with one unit, claimants share it equally
  units      Int           @default(1)
  createdAt  DateTime      @default(now())

  @@unique([itemId, lineUserId])
}

model GroupDebt {
  id           String          @id @default(uuid())
  groupId      String
  group        LineGroup       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  billId       String
  bill         GroupBill       @relation(fields: [billId], references: [id], onDelete: Cascade)
  debtorId     String
  creditorId   String
  amount       Decimal         @db.Decimal(12, 2)
  status       GroupDebtStatus @default(OPEN)
  /// Bank reference of the slip that paid it; one slip may settle several debts at once, but is never reused
  slipRef      String?
  paidAt       DateTime?
  lastRemindedAt DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @default(now()) @updatedAt

  @@index([groupId, status])
  @@index([debtorId, status])
  @@index([slipRef])
}

/// Metered group actions: receipt reads (monthly cap) and repayment slip checks (daily cap)
model GroupUsageEvent {
  id         String    @id @default(uuid())
  groupId    String
  group      LineGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  kind       String
  lineUserId String
  createdAt  DateTime  @default(now())

  @@index([groupId, kind, createdAt])
}
